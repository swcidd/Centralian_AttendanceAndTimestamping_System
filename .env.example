# Card reader the Encode Card page talks to. Point this at the ESP32
# terminal (it serves /health and /encode itself, e.g.
# http://192.168.1.50:8787) and no desktop bridge is needed. Leave it at
# localhost to use tools/encoder_server.py with a USB reader instead.
VITE_ENCODER_URL=http://localhost:8787
