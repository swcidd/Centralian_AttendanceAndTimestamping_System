#pragma once

// Copy this file to config.h (gitignored) and fill in real values.
// config.h is generated locally per device/developer and never committed.

#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Pre-shared key used for HMAC_SHA256(PSK, MAC + Timestamp + NFC_UID)
// on every tap posted to ingest-tap.
#define DEVICE_PSK "replace-with-shared-secret"

#define API_ENDPOINT_URL "https://your-project.functions.supabase.co/ingest-tap"

// Port the terminal's own HTTP encode server listens on. The dashboard's
// Encode Card page talks to http://<device-ip>:<this-port>/encode, so the
// desktop bridge (tools/encoder_server.py) is not needed.
#define ENCODER_HTTP_PORT 8787
